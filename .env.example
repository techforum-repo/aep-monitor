# =========================================================
# Adobe Experience Cloud Monitor (AEP / Data Collection / CJA)
# Environment Configuration
#
# Every line below maps to a field in aep_monitor/config.py's Settings
# class. Anything not listed here has no effect on the app.
# =========================================================

# -----------------------------
# Application
# -----------------------------
APP_ENV=development

# -----------------------------
# Mode switch
# -----------------------------
# true  = every page shows realistic sample data, no Adobe call is ever made.
# false = live calls, requires the credential fields below.
MOCK_MODE=true

# -----------------------------
# Adobe I/O OAuth Server-to-Server credential
# One credential for every product this app talks to: AEP (Flow Service,
# Audit Query, Observability, Quota), Data Collection (Reactor), and CJA.
#
# Set up: Adobe Developer Console (developer.adobe.com/console) -> Create
# one project -> Add API, repeated for each of:
#   - "Experience Platform API"        (AEP / Audit Query / Observability / Quota)
#   - "Experience Platform Launch API" (Data Collection)
#   - "Customer Journey Analytics API" (CJA)
# -> OAuth Server-to-Server -> select a product profile with access to
# each. Adding all three to the same project gives you one client_id/secret
# whose scope string just combines all three — paste that combined scope
# string into ADOBE_SCOPES below.
# -----------------------------
ADOBE_ORG_ID=
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
# Paste the exact scope string shown on the credential's page in the console.
ADOBE_SCOPES=
ADOBE_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
# The AEP sandbox to monitor (Sandboxes page in AEP UI; "prod" is the default sandbox).
ADOBE_SANDBOX=prod
# Optional. Adobe's Observability Insights docs list this as required
# alongside ADOBE_SANDBOX, but Adobe's own published Postman collection for
# the same API doesn't send it — left optional. Only set it if the AEP
# Ingestion page's "Org-wide health" section errors without it (find it on
# the Sandboxes page in the AEP UI).
ADOBE_SANDBOX_ID=
# Comma-separated sandbox names for the Compare Sandboxes page (e.g.
# "prod,dev,stage"). Only AEP is sandbox-scoped in Adobe's architecture, so
# this only affects that one page. Leave blank to compare just ADOBE_SANDBOX.
ADOBE_SANDBOXES=

# -----------------------------
# Alerting
# -----------------------------
# A dataflow run alerts once its failed record count exceeds this (0 = any failure alerts).
ALERT_FAILED_RECORDS_THRESHOLD=0
# A data-lifecycle quota (dataset expiration, consumer-delete identities)
# alerts once consumed/quota reaches this percentage.
ALERT_QUOTA_THRESHOLD_PCT=80
# Optional: an incoming webhook URL (Slack "Incoming Webhooks" app) — a new
# alert posts there once, not on every subsequent poll while still open.
SLACK_WEBHOOK_URL=

# -----------------------------
# Networking
# -----------------------------
HTTP_TIMEOUT=30
REQUESTS_PER_SECOND=5
CACHE_TTL_SECONDS=300
